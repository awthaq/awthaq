{
  "extends": "./tsconfig.base.json",
  "include": [
    "features/**/*.steps.test.ts",
    "packages/*/test/**/*.test.ts",
    "packages/*/test/**/*.test.tsx",
    "examples/plugin-template/test/**/*.test.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    // `declaration: true` is inherited from `tsconfig.base.json` for the
    // composite package builds — it has no purpose here (`noEmit` already
    // means nothing is ever written), but TS's own "is this declaration
    // portable" check (TS2883, "cannot be named without a reference to...")
    // still runs whenever it is nominally on, independent of `noEmit` —
    // surfaced only once `@awthaq/react`'s `AuthClientAtom.ts` (a
    // deeply generic `AtomHttpApi.Service<Self>()(...)` return type) joined
    // this shared program via its own `.tsx` test file. Overriding it off
    // here (this config never emits anyway) turns the check off with it.
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    // Same rationale as tsconfig.base.json's `paths`: lets test files resolve
    // a sibling workspace package by source rather than by built output.
    "paths": {
      "@awthaq/api": ["./packages/api/src/index.ts"],
      "@awthaq/ports": ["./packages/ports/src/index.ts"],
      "@awthaq/sql": ["./packages/sql/src/index.ts"],
      "@awthaq/core": ["./packages/core/src/index.ts"],
      "@awthaq/server": ["./packages/server/src/index.ts"],
      "@awthaq/qadi": ["./packages/qadi/src/index.ts"],
      "@awthaq/client": ["./packages/client/src/index.ts"],
      "@awthaq/react": ["./packages/react/src/index.ts"],
      "@awthaq/next": ["./packages/next/src/index.ts"],
      "@awthaq/test": ["./packages/test/src/index.ts"],
      "@awthaq/cli": ["./packages/cli/src/index.ts"],
      "@awthaq/password": ["./packages/password/src/index.ts"],
      "@awthaq/oauth": ["./packages/oauth/src/index.ts"],
      "@awthaq/passkey": ["./packages/passkey/src/index.ts"],
      "@awthaq/roles": ["./packages/roles/src/index.ts"],
      "@awthaq/magic-link": ["./packages/magic-link/src/index.ts"],
      "@awthaq/two-factor": ["./packages/two-factor/src/index.ts"],
      "@awthaq/organization": ["./packages/organization/src/index.ts"],
      "@awthaq/api-key": ["./packages/api-key/src/index.ts"],
      "@awthaq/admin": ["./packages/admin/src/index.ts"],
      "@awthaq/jwt": ["./packages/jwt/src/index.ts"],
      "@awthaq/migrate-auth0": ["./packages/migrate-auth0/src/index.ts"],
      "@awthaq/migrate-better-auth": ["./packages/migrate-better-auth/src/index.ts"]
    }
  }
}
