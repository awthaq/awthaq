{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".scratch/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "spec/scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "@arethetypeswrong/cli"
      ]
    },
    "packages/ports": {
      "entry": [
        "src/passwordHasherWorker.ts"
      ]
    },
    "packages/two-factor": {
      "ignoreDependencies": [
        "@awthaq/api",
        "@awthaq/core",
        "@awthaq/ports",
        "@awthaq/server",
        "@awthaq/sql",
        "@effect/vitest",
        "effect"
      ]
    },
    "packages/magic-link": {
      "ignoreDependencies": [
        "@awthaq/api",
        "@awthaq/core",
        "@awthaq/ports",
        "@awthaq/server",
        "@awthaq/sql",
        "@effect/vitest",
        "effect"
      ]
    },
    "packages/cli": {
      "entry": [
        "test/fixtures/*.config.ts"
      ],
      "ignoreExportsUsedInFile": true
    },
    "packages/migrate-better-auth": {
      "ignore": [
        "test/fixtures/generate-better-auth-export.mjs"
      ]
    },
    "features": {
      "entry": [
        "step-definitions/**/*.ts",
        "features/**/*.steps.test.ts"
      ]
    }
  }
}
