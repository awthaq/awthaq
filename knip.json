{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".scratch/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["@arethetypeswrong/cli"]
    },
    "packages/ports": {
      "entry": ["src/passwordHasherWorker.ts"]
    },
    "packages/two-factor": {
      "ignoreDependencies": [
        "@awthaq/api",
        "@awthaq/core",
        "@awthaq/ports",
        "@awthaq/server",
        "@awthaq/sql",
        "@effect/vitest",
        "effect"
      ]
    },
    "packages/magic-link": {
      "ignoreDependencies": [
        "@awthaq/api",
        "@awthaq/core",
        "@awthaq/ports",
        "@awthaq/server",
        "@awthaq/sql",
        "@effect/vitest",
        "effect"
      ]
    },
    "packages/cli": {
      "ignoreDependencies": [
        "@awthaq/api",
        "@awthaq/core",
        "@awthaq/ports",
        "@awthaq/qadi",
        "@awthaq/server",
        "@awthaq/sql",
        "@effect/vitest",
        "effect"
      ]
    }
  }
}
