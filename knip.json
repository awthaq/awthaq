{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".scratch/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "spec/scripts/*.mjs"],
      "ignoreDependencies": ["@arethetypeswrong/cli"]
    },
    "packages/ports": {
      "entry": ["src/passwordHasherWorker.ts"]
    },
    "packages/cli": {
      "entry": ["test/fixtures/*.config.ts"],
      "ignoreExportsUsedInFile": true
    },
    "packages/migrate-better-auth": {
      "ignore": ["test/fixtures/generate-better-auth-export.mjs"]
    }
  }
}
