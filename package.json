{
  "name": "awthaq-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "awthaq: a TypeScript authentication runtime built natively on Effect v4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "bash scripts/test-pg.sh",
    "test:bdd": "pnpm --filter @awthaq/features test",
    "coverage": "vitest run --coverage",
    "circular": "node scripts/circular.mjs",
    "check:readmes": "node scripts/check-readme-status.mjs",
    "check:error-tags": "node scripts/check-error-tags.mjs",
    "quality:dashboard": "node scripts/generate-quality-dashboard.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "spec:verify": "bash spec/scripts/verify-traceability.sh",
    "spec:verify:strict": "bash spec/scripts/verify-traceability.sh --strict",
    "package:smoke": "node scripts/package-smoke.mjs",
    "workspace:sync": "node scripts/sync-workspace.mjs --write",
    "workspace:check": "node scripts/sync-workspace.mjs --check",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "check": "pnpm workspace:check && pnpm typecheck && pnpm package:smoke && pnpm lint && pnpm knip && pnpm format:check && pnpm circular && pnpm check:readmes && pnpm check:error-tags && pnpm coverage && pnpm test:bdd && pnpm spec:verify:strict",
    "changeset": "changeset",
    "changeset-version": "changeset version",
    "changeset-publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "^1.82.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "glob": "^13.0.0",
    "knip": "^6.35.1",
    "madge": "^8.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.24",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.20.0"
}
