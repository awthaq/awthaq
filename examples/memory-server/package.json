{
  "name": "@awthaq/example-memory-server",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable example: Password + Organization composed over @awthaq/test's memory backend, through a real listening HTTP server. Additional to, not a replacement for, the README's own single-plugin Postgres quickstart.",
  "type": "module",
  "scripts": {
    "prestart": "pnpm --workspace-root run build",
    "start": "node --experimental-strip-types index.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/organization": "workspace:*",
    "@awthaq/password": "workspace:*",
    "@awthaq/ports": "workspace:*",
    "@awthaq/qadi": "workspace:*",
    "@awthaq/roles": "workspace:*",
    "@awthaq/server": "workspace:*",
    "@awthaq/test": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@qadi/core": "^0.7.0",
    "@qadi/http": "^0.7.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
