{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "paths": {
      "@awthaq/api": ["../../packages/api/src/index.ts"],
      "@awthaq/core": ["../../packages/core/src/index.ts"]
