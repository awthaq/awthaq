{
  "name": "@awthaq/example-plugin-template",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal, test-exercised template plugin: copy it and docs/plugin-authoring.md to start a plugin. Every convention in one small package.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@awthaq/ports": "workspace:*",
    "@awthaq/server": "workspace:*",
    "@awthaq/test": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
