{
  "name": "@awthaq/scim",
  "version": "0.1.0",
  "private": true,
  "description": "Inbound SCIM 2.0 (RFC 7644) provisioning: an identity provider creates, updates and deactivates an organization's users and groups, and deactivation ends their sessions.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/organization": "workspace:*",
    "@awthaq/sql": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@awthaq/ports": "workspace:*",
    "@awthaq/server": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
