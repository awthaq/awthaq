{
  "name": "@awthaq/organization",
  "version": "0.2.0",
  "description": "Multi-tenancy: membership, invitations, a relationship resolver for qadi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awthaq/awthaq.git",
    "directory": "packages/organization"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./records": {
      "types": "./lib/records.d.ts",
      "bun": "./src/records.ts",
      "import": "./lib/records.js",
      "default": "./lib/records.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/oauth": "workspace:*",
    "@awthaq/ports": "workspace:*",
    "@awthaq/sql": "workspace:*"
  },
  "devDependencies": {
    "@awthaq/test": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-libsql": "catalog:",
    "@effect/vitest": "catalog:",
    "@qadi/core": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@qadi/core": "catalog:peer",
    "effect": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
