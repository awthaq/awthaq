{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@awthaq/core": ["../core/src/index.ts"],
      "@awthaq/ports": ["../ports/src/index.ts"],
      "@awthaq/api": ["../api/src/index.ts"]
    }
  },
  "references": [
    {
      "path": "../core/tsconfig.src.json"
    },
    {
      "path": "../ports/tsconfig.src.json"
    },
    {
      "path": "../api/tsconfig.src.json"
    }
  ]
}
