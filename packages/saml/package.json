{
  "name": "@awthaq/saml",
  "version": "0.1.0",
  "private": true,
  "description": "SAML 2.0 service provider (SP only): SP-initiated login, hardened XML-signature verification behind the XmlSignature port, per-organization connections.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/organization": "workspace:*",
    "@awthaq/ports": "workspace:*",
    "@awthaq/sql": "workspace:*",
    "@qadi/core": "^0.7.0",
    "@xmldom/xmldom": "0.8.15",
    "effect": "catalog:",
    "xml-crypto": "6.3.2"
  },
  "devDependencies": {
    "@awthaq/server": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
