{
  "name": "@awthaq/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The awthaq command line: doctor, config list, plugin list --graph, routes, migration status|apply, openapi, seed admin, import, login|logout|whoami. Reads the plugin manifest; never serves the application.",
  "license": "MIT",
  "bin": {
    "awthaq": "./lib/bin.js"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/client": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/migrate-better-auth": "workspace:*",
    "@awthaq/migrate-firebase": "workspace:*",
    "@awthaq/ports": "workspace:*",
    "@awthaq/roles": "workspace:*",
    "@awthaq/server": "workspace:*",
    "@awthaq/sql": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@awthaq/password": "workspace:*",
    "@awthaq/test": "workspace:*",
    "@effect/vitest": "catalog:",
    "@qadi/core": "^0.7.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
