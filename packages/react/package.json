{
  "name": "@awthaq/react",
  "version": "0.2.0",
  "description": "React bindings: reactive AtomHttpApi clients over the awthaq contract (CSRF via @awthaq/client) and Providers with QadiProvider integration.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awthaq/awthaq.git",
    "directory": "packages/react"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/client": "workspace:*"
  },
  "devDependencies": {
    "@effect/atom-react": "catalog:",
    "@effect/vitest": "catalog:",
    "@qadi/core": "catalog:",
    "@qadi/react": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/atom-react": "catalog:peer",
    "@qadi/core": "catalog:peer",
    "@qadi/react": "catalog:peer",
    "effect": "catalog:peer",
    "react": ">=19.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
