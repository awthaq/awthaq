{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    // Browser-facing: the base config carries no DOM lib (AH-009).
    "lib": ["ESNext", "DOM"],
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@awthaq/api": ["../api/src/index.ts"],
      "@awthaq/jwt/verify": ["../jwt/src/verify.ts"],
      "@awthaq/server": ["../server/src/index.ts"],
      "@awthaq/jwt": ["../jwt/src/index.ts"],
      "@awthaq/web": ["../web/src/index.ts"],
      "@awthaq/web/cookies": ["../web/src/cookies.ts"]
    }
  },
  "references": [
    {
      "path": "../api/tsconfig.src.json"
    },
    {
      "path": "../jwt/tsconfig.src.json"
    },
    {
      "path": "../server/tsconfig.src.json"
    },
    {
      "path": "../web/tsconfig.src.json"
    }
  ]
}
