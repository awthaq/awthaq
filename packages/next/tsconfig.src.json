{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@effect-auth/api": ["../api/src/index.ts"],
      "@effect-auth/core": ["../core/src/index.ts"],
      "@effect-auth/react": ["../react/src/index.ts"],
      "@effect-auth/server": ["../server/src/index.ts"]
    }
  },
  "references": [
    {
      "path": "../api/tsconfig.src.json"
    },
    {
      "path": "../core/tsconfig.src.json"
    },
    {
      "path": "../react/tsconfig.src.json"
    },
    {
      "path": "../server/tsconfig.src.json"
    }
  ]
}
