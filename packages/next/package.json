{
  "name": "@awthaq/next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js adapter: database-verified getSession, optimistic proxy.ts cookie check, Set-Cookie bridging for server actions.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./edge": {
      "types": "./lib/edge.d.ts",
      "bun": "./src/edge.ts",
      "import": "./lib/edge.js",
      "default": "./lib/edge.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/client": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/jwt": "workspace:*",
    "@awthaq/server": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@awthaq/ports": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
