{
  "name": "@awthaq/test",
  "version": "0.1.0",
  "private": true,
  "description": "TestAuth test harness and the plugin contract-test suite (runPluginContractTests) — runs the whole plugin pipeline over an in-memory backend.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/ports": "workspace:*",
    "@awthaq/server": "workspace:*",
    "@awthaq/sql": "workspace:*"
  },
  "devDependencies": {
    "@awthaq/password": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:peer",
    "@effect/sql-pg": "catalog:peer",
    "@effect/sql-sqlite-node": "catalog:peer",
    "effect": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
