{
  "name": "@awthaq/web",
  "version": "0.2.0",
  "private": true,
  "description": "Framework-neutral web-adapter core: cookie-jar bridge, database-verified session read and rotation, presence check, and the in-process CSRF-echoing client. The base a Next, Astro or SvelteKit adapter shares.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./cookies": {
      "types": "./lib/cookies.d.ts",
      "bun": "./src/cookies.ts",
      "import": "./lib/cookies.js",
      "default": "./lib/cookies.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/client": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/server": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
