{
  "name": "@awthaq/roles",
  "version": "0.2.0",
  "description": "A SubjectResolver override that flattens roles through a role DAG into qadi's AuthSubject.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awthaq/awthaq.git",
    "directory": "packages/roles"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@awthaq/api": "workspace:*",
    "@awthaq/core": "workspace:*",
    "@awthaq/ports": "workspace:*",
    "@awthaq/qadi": "workspace:*"
  },
  "devDependencies": {
    "@awthaq/test": "workspace:*",
    "@effect/vitest": "catalog:",
    "@qadi/core": "catalog:",
    "@qadi/http": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@qadi/core": "catalog:peer",
    "@qadi/http": "catalog:peer",
    "effect": "catalog:peer"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
