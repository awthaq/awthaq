{
  "extends": "../tsconfig.base.json",
  "include": ["step-definitions/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./lib",
    "rootDir": ".",
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "paths": {
      "@effect-auth/api": ["../packages/api/src/index.ts"],
      "@effect-auth/core": ["../packages/core/src/index.ts"],
      "@effect-auth/ports": ["../packages/ports/src/index.ts"],
      "@effect-auth/server": ["../packages/server/src/index.ts"],
      "@effect-auth/sql": ["../packages/sql/src/index.ts"],
      "@effect-auth/password": ["../packages/password/src/index.ts"],
      "@effect-auth/oauth": ["../packages/oauth/src/index.ts"],
      "@effect-auth/passkey": ["../packages/passkey/src/index.ts"],
      "@effect-auth/organization": ["../packages/organization/src/index.ts"],
      "@effect-auth/admin": ["../packages/admin/src/index.ts"],
      "@effect-auth/jwt": ["../packages/jwt/src/index.ts"]
    }
  },
  "references": [
    { "path": "../packages/api/tsconfig.src.json" },
    { "path": "../packages/core/tsconfig.src.json" },
    { "path": "../packages/ports/tsconfig.src.json" },
    { "path": "../packages/server/tsconfig.src.json" },
    { "path": "../packages/sql/tsconfig.src.json" },
    { "path": "../packages/password/tsconfig.src.json" },
    { "path": "../packages/oauth/tsconfig.src.json" },
    { "path": "../packages/passkey/tsconfig.src.json" },
    { "path": "../packages/organization/tsconfig.src.json" },
    { "path": "../packages/admin/tsconfig.src.json" },
    { "path": "../packages/jwt/tsconfig.src.json" }
  ]
}
