{
  "exclude": ["node_modules", "lib", "dist"],
  "compilerOptions": {
    "types": ["node"],
    // Enable latest features
    // No `DOM` here (AH-009): a server package that reaches for `document`/`window` (or a
    // DOM-only type such as `CryptoKey`, which Node declares under `webcrypto`) must fail
    // typecheck. The browser-facing packages (client, react, next) and `tsconfig.test.json`
    // (whose one program includes their tests) opt in to `DOM` themselves.
    "lib": ["ESNext"],
    // `react-jsx` only takes effect for a `.tsx` file; every other package's
    // `.ts` files are unaffected by this setting being on globally.
    "jsx": "react-jsx",
    "target": "ESNext",
    "moduleDetection": "force",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    // Bundler mode
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    // This is an authentication library: indexed access must be checked
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noErrorTruncation": true,
    // Workspace packages resolve to source, not to built output, via `paths` below.
    // The `@awthaq/*` entries are generated from packages/*/package.json by
    // `pnpm workspace:sync` and verified by `pnpm workspace:check` (part of `pnpm check`);
    // do not add one by hand.
    "paths": {
      "@awthaq/api": ["./packages/api/src/index.ts"],
      "@awthaq/ports": ["./packages/ports/src/index.ts"],
      "@awthaq/sql": ["./packages/sql/src/index.ts"],
      "@awthaq/core": ["./packages/core/src/index.ts"],
      "@awthaq/server": ["./packages/server/src/index.ts"],
      "@awthaq/qadi": ["./packages/qadi/src/index.ts"],
      "@awthaq/client": ["./packages/client/src/index.ts"],
      "@awthaq/react": ["./packages/react/src/index.ts"],
      "@awthaq/next": ["./packages/next/src/index.ts"],
      "@awthaq/test": ["./packages/test/src/index.ts"],
      "@awthaq/cli": ["./packages/cli/src/index.ts"],
      "@awthaq/password": ["./packages/password/src/index.ts"],
      "@awthaq/oauth": ["./packages/oauth/src/index.ts"],
      "@awthaq/passkey": ["./packages/passkey/src/index.ts"],
      "@awthaq/roles": ["./packages/roles/src/index.ts"],
      "@awthaq/magic-link": ["./packages/magic-link/src/index.ts"],
      "@awthaq/two-factor": ["./packages/two-factor/src/index.ts"],
      "@awthaq/organization": ["./packages/organization/src/index.ts"],
      "@awthaq/api-key": ["./packages/api-key/src/index.ts"],
      "@awthaq/admin": ["./packages/admin/src/index.ts"],
      "@awthaq/jwt": ["./packages/jwt/src/index.ts"],
      "@awthaq/jwt/verify": ["./packages/jwt/src/verify.ts"],
      "@awthaq/migrate-auth0": ["./packages/migrate-auth0/src/index.ts"],
      "@awthaq/migrate-better-auth": ["./packages/migrate-better-auth/src/index.ts"],
      "@awthaq/migrate-firebase": ["./packages/migrate-firebase/src/index.ts"],
      "@awthaq/scim": ["./packages/scim/src/index.ts"],
      "@awthaq/next/edge": ["./packages/next/src/edge.ts"],
      "@awthaq/oauth/presets": ["./packages/oauth/src/presets/index.ts"],
      "@awthaq/webhooks": ["./packages/webhooks/src/index.ts"],
      "@awthaq/saml": ["./packages/saml/src/index.ts"],
      "@awthaq/web": ["./packages/web/src/index.ts"],
      "@awthaq/web/cookies": ["./packages/web/src/cookies.ts"],
      "@awthaq/device-authorization": ["./packages/device-authorization/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "namespaceImportPackages": ["effect", "@effect/*", "@awthaq/*", "@effect-cucumber/*"],
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": false,
        "diagnosticSeverity": {
          "duplicatePackage": "error",
          "genericEffectServices": "error",
          "outdatedApi": "error",
          "effectFnIife": "error",
          "effectGenUsesAdapter": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "layerMergeAllWithDependencies": "error",
          "lazyPromiseInEffectSync": "error",
          "multipleEffectProvide": "error",
          "scopeInLayerEffect": "error",
          "unknownInEffectCatch": "error"
        }
      }
    ]
  }
}
